# Database
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/nextstep_db

# Security
SECRET_KEY=change-this-in-production
JWT_SECRET_KEY=change-this-in-production

# External APIs
QUIZ_API_KEY=your-quiz-api-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEYS=key1,key2,key3 # Comma-separated list for key rotation (optional)
CRON_TOKEN=your-cron-secret-token # Used for /api/jobs/cron-sync endpoint security
GOOGLE_CLIENT_ID=your-google-client-id

# CORS Configuration
# Comma-separated list of allowed frontend domains
CORS_ORIGINS=https://your-frontend-domain.com,http://localhost:5173

# AI Settings
AI_PROVIDER=gemini # Use gemini for production

# Firebase Admin SDK path (ensure the file is injected or loaded in prod)
# FIREBASE_CREDENTIALS=/app/firebase-service-account.json
